    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prisma": "6.15.0",
    "tsx": "^4.20.3",
    "typescript": "~5.7.2",
    "vitest": "^3.2.7"
  }
}
